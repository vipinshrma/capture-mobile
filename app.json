{
  "expo": {
    "name": "Tuck",
    "slug": "tuck",
    "scheme": "tuck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.capture.inbox"
    },
    "android": {
      "package": "com.capture.inbox"
    },
    "plugins": [
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebPageWithMaxCount": 1,
              "supportsWebUrlWithMaxCount": 1
            }
          }
        }
      ],
      "expo-sqlite"
    ]
  }
}
